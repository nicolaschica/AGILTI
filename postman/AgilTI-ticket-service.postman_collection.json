      "name": "2.1 Titulo con \"<\" repetido (400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda cuantos tickets hay para comprobar luego que el rechazo no creo ninguno",
              "pm.sendRequest(pm.variables.get('baseUrl') + '/api/tickets?size=1', function (err, res) {",
              "    pm.variables.set('totalAntes', err ? -1 : res.json().totalElements);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 400', function () { pm.response.to.have.status(400); });",
              "pm.test('mensaje exacto de la regla', function () {",
              "    pm.expect(pm.response.json().mensaje).to.eql(\"titulo: El título contiene caracteres no permitidos. Usa solo letras, números y signos básicos como . , - ( ).\");",
              "});",
              "pm.sendRequest(pm.variables.get('baseUrl') + '/api/tickets?size=1', function (err, res) {",
              "    pm.test('No se creo ningun ticket', function () {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.json().totalElements).to.eql(Number(pm.variables.get('totalAntes')));",
