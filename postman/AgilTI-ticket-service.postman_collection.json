{
  "info": {
    "name": "AgilTI - ticket-service",
    "description": "Coleccion para probar en tiempo real los 4 endpoints de ticket-service, segun el contrato ticket-service-openapi.yaml. Incluye casos de exito y de error (400/404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Crear ticket (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('El ticket trae tecnicoAsignado', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.tecnicoAsignado).to.not.be.null;",
              "    pm.expect(body.estado).to.eql('ABIERTO');",
              "});",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('ticketId', body.id);",
              "console.log('ticketId guardado:', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"No enciende el computador\",\n  \"descripcion\": \"El equipo del area contable no enciende desde esta manana\",\n  \"prioridad\": \"ALTA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        }
      }
    },
    {
